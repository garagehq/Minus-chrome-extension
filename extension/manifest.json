{
  "manifest_version": 3,
  "name": "Minus — vision ad blocker",
  "version": "0.4.2",
  "description": "Blocks ads the way the minus device does — by looking at them. Ad elements are detected with a vision model and covered with language flashcards.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "offscreen",
    "alarms",
    "unlimitedStorage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "spanish.js",
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Minus",
    "default_icon": {
      "16": "icons/m-blue-16.png",
      "32": "icons/m-blue-32.png",
      "48": "icons/m-blue-48.png",
      "128": "icons/m-blue-128.png"
    }
  },
  "icons": {
    "16": "icons/m-blue-16.png",
    "32": "icons/m-blue-32.png",
    "48": "icons/m-blue-48.png",
    "128": "icons/m-blue-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "decks/*.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "toggle-blocking": {
      "description": "Toggle Minus ad blocking on/off"
    }
  }
}