# Copy to server/.env and fill in. NEVER commit the real .env.
# Run locally:  node --env-file=server/.env server/ingest-server.mjs

# Private HF dataset that receives contributions (create it first, Private).
HF_DATASET=garagehq/minus-web-captures

# Fine-grained HF token with WRITE access to JUST that dataset. Secret.
# On Fly.io set this with `fly secrets set` (see DEPLOY.md), not in this file.
HF_TOKEN=hf_replace_me

# Shared secret the extension must send as `x-minus-key`. Generate a random
# string (e.g. `openssl rand -hex 24`). Stops randoms from POSTing junk.
INGEST_KEY=replace_with_a_long_random_string

# Local staging dir + port (defaults are fine).
MINUS_INGEST_DIR=./captures
PORT=8790

# Flush to HF every N samples (default 50).
BATCH_UPLOAD=50
